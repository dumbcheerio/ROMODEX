<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>ROMODEX</title>

  <style>
    :root {
      --bg: #0c0d10;
      --surface: #15171c;
      --surface-2: #1c1f26;
      --border: #292d36;

      --text: #f7f7f8;
      --muted: #8e95a3;

      --accent: #FC96C5;
      --accent-soft: rgba(252, 150, 197, 0.12);

      --red: #ff6b6b;
      --yellow: #f4c95d;
      --green: #62d394;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      min-height: 100vh;

      background:
        radial-gradient(
          circle at top,
          #191b27 0%,
          var(--bg) 42%
        );

      color: var(--text);

      font-family:
        Inter,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
    }

    button,
    input,
    textarea {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    .app {
      width: min(1050px, 94%);
      margin: auto;
      padding: 28px 0 70px;
    }

    /* ---------------- HEADER ---------------- */

    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;

      margin-bottom: 30px;
    }

    .logo h1 {
      margin: 0;

      font-size: 1.8rem;
      letter-spacing: -0.05em;
    }

    .logo p {
      margin: 5px 0 0;

      color: var(--muted);

      font-size: 0.88rem;
    }

    nav {
      display: flex;
      gap: 7px;

      padding: 5px;

      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 13px;
    }

    .nav-button {
      border: 0;
      border-radius: 9px;

      padding: 9px 14px;

      color: var(--muted);
      background: transparent;
    }

    .nav-button.active {
      color: white;
      background: var(--surface-2);
    }

    /* ---------------- GENERIC ---------------- */

    .page {
      display: none;
    }

    .page.active {
      display: block;
    }

    .card {
      background: rgba(21, 23, 28, 0.96);

      border: 1px solid var(--border);
      border-radius: 20px;

      padding: 26px;

      box-shadow:
        0 20px 60px rgba(0, 0, 0, 0.22);
    }

    .hidden {
      display: none !important;
    }

    .muted {
      color: var(--muted);
    }

    .small {
      font-size: 0.82rem;
      color: var(--muted);
    }

    .primary {
      border: 0;
      border-radius: 12px;

      padding: 13px 20px;

      color: white;
      background: var(--accent);

      font-weight: 750;

      transition:
        transform 0.15s ease,
        opacity 0.15s ease;
    }

    .primary:hover {
      transform: translateY(-1px);
    }

    .primary:disabled {
      opacity: 0.4;
      cursor: not-allowed;
      transform: none;
    }

    .secondary {
      padding: 12px 17px;

      color: var(--text);
      background: var(--surface-2);

      border: 1px solid var(--border);
      border-radius: 12px;
    }

    .danger-button {
      color: var(--red);
    }

    /* ---------------- PRACTICE ---------------- */

    .practice-layout {
      display: grid;
      grid-template-columns: 1.25fr 0.75fr;

      gap: 22px;
    }

    .picker-card {
      display: flex;
      flex-direction: column;
      align-items: center;

      min-height: 500px;
    }

    .picker-title {
      width: 100%;
    }

    .picker-title h2 {
      margin: 0;
      font-size: 1rem;
    }

    /* ---------------- ROLODEX ---------------- */

    .picker-container {
      position: relative;

      width: min(500px, 100%);
      height: 330px;

      margin: 35px auto 25px;

      overflow: hidden;
    }

    .topic-picker {
      position: relative;

      width: 100%;
      height: 100%;

      overflow-y: scroll;

      padding: 132px 0;

      scroll-snap-type: y mandatory;

      scrollbar-width: none;

      -webkit-overflow-scrolling: touch;
    }

    .topic-picker::-webkit-scrollbar {
      display: none;
    }

    .picker-item {
      height: 66px;

      display: flex;
      align-items: center;
      justify-content: center;

      padding: 0 30px;

      text-align: center;

      scroll-snap-align: center;

      color: var(--muted);

      font-size: 1.12rem;
      font-weight: 600;

      opacity: 0.3;

      transform: scale(0.82);

      transition:
        transform 0.18s ease,
        opacity 0.18s ease,
        color 0.18s ease,
        filter 0.18s ease;

      user-select: none;
    }

    .picker-item.near {
      opacity: 0.6;
      transform: scale(0.93);
    }

    .picker-item.active {
      color: white;

      font-size: 1.3rem;
      font-weight: 800;

      opacity: 1;

      transform: scale(1.05);
    }

    .selection-box {
      position: absolute;

      top: 132px;
      left: 5%;
      right: 5%;

      height: 66px;

      border-top: 1px solid var(--accent);
      border-bottom: 1px solid var(--accent);

      background: var(--accent-soft);

      border-radius: 8px;

      pointer-events: none;

      z-index: 3;
    }

    .picker-fade-top,
    .picker-fade-bottom {
      position: absolute;

      left: 0;
      right: 0;

      height: 120px;

      pointer-events: none;

      z-index: 4;
    }

    .picker-fade-top {
      top: 0;

      background:
        linear-gradient(
          to bottom,
          var(--surface) 10%,
          rgba(21, 23, 28, 0)
        );
    }

    .picker-fade-bottom {
      bottom: 0;

      background:
        linear-gradient(
          to top,
          var(--surface) 10%,
          rgba(21, 23, 28, 0)
        );
    }

    #randomizeButton {
      min-width: 170px;
    }

    /* ---------------- SELECTION PANEL ---------------- */

    .selection-card {
      display: flex;
      flex-direction: column;

      min-height: 500px;
    }

    .selection-label {
      margin-top: 2px;

      color: var(--muted);

      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }

    .selected-topic {
      min-height: 90px;

      display: flex;
      align-items: center;

      margin: 8px 0 10px;

      font-size: clamp(1.5rem, 4vw, 2.15rem);
      font-weight: 800;
      line-height: 1.15;
      letter-spacing: -0.04em;
    }

    .decision-buttons {
      display: grid;
      grid-template-columns: 1fr;

      gap: 10px;

      margin-top: auto;
    }

    .decision-button {
      padding: 17px;

      text-align: left;

      color: var(--text);
      background: var(--surface-2);

      border: 1px solid var(--border);
      border-radius: 14px;
    }

    .decision-button:hover {
      border-color: var(--accent);
    }

    .decision-button strong {
      display: block;

      margin-bottom: 5px;

      font-size: 1rem;
    }

    .decision-button span {
      color: var(--muted);

      font-size: 0.83rem;
    }

    /* ---------------- TIMER SCREEN ---------------- */

    .session-card {
      width: min(760px, 100%);
      margin: auto;
    }

    .phase-label {
      color: var(--accent);

      font-size: 0.77rem;
      font-weight: 800;

      letter-spacing: 0.13em;
      text-transform: uppercase;
    }

    .session-topic {
      margin: 8px 0 20px;

      font-size: clamp(1.7rem, 5vw, 2.8rem);
      letter-spacing: -0.05em;
      line-height: 1.1;
    }

    .timer {
      margin: 35px 0;

      text-align: center;

      font-size: clamp(4.5rem, 15vw, 8rem);
      font-weight: 800;
      font-variant-numeric: tabular-nums;

      letter-spacing: -0.07em;
    }

    .timer.warning {
      color: var(--yellow);
    }

    .timer.danger {
      color: var(--red);
    }

    textarea,
    input {
      width: 100%;

      padding: 13px 14px;

      color: var(--text);
      background: #0e1014;

      border: 1px solid var(--border);
      border-radius: 11px;

      outline: none;
    }

    textarea:focus,
    input:focus {
      border-color: var(--accent);
    }

    textarea {
      min-height: 190px;
      resize: vertical;
    }

    .controls {
      display: flex;
      flex-wrap: wrap;

      gap: 9px;

      margin-top: 17px;
    }

    .recitation-instruction {
      max-width: 580px;

      margin: 0 auto 25px;

      color: var(--muted);

      text-align: center;
      line-height: 1.7;
    }

    /* ---------------- REVIEW ---------------- */

    .rating-container {
      display: grid;
      grid-template-columns: repeat(5, 1fr);

      gap: 8px;

      margin: 18px 0 25px;
    }

    .rating-button {
      padding: 15px 5px;

      color: var(--text);
      background: var(--surface-2);

      border: 1px solid var(--border);
      border-radius: 11px;

      font-weight: 700;
    }

    .rating-button.selected {
      background: var(--accent);
      border-color: var(--accent);
    }

    /* ---------------- TOPICS ---------------- */

    .topics-layout {
      display: grid;
      grid-template-columns: 0.8fr 1.2fr;

      gap: 22px;
    }

    .topic-form {
      display: flex;
      gap: 8px;

      margin-top: 20px;
    }

    .topic-form input {
      flex: 1;
    }

    .topic-list {
      margin-top: 17px;

      display: flex;
      flex-direction: column;

      gap: 8px;
    }

    .topic-row {
      display: flex;
      justify-content: space-between;
      align-items: center;

      gap: 10px;

      padding: 13px 15px;

      background: var(--surface-2);

      border: 1px solid var(--border);
      border-radius: 11px;
    }

    .delete-topic {
      padding: 5px;

      border: 0;

      color: var(--red);
      background: transparent;
    }

    /* ---------------- HISTORY ---------------- */

    .history-list {
      display: flex;
      flex-direction: column;
      gap: 9px;

      margin-top: 18px;
    }

    .history-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;

      gap: 18px;

      padding: 15px;

      background: var(--surface-2);

      border: 1px solid var(--border);
      border-radius: 12px;
    }

    .history-topic {
      font-weight: 750;
    }

    .history-meta {
      margin-top: 4px;

      color: var(--muted);

      font-size: 0.8rem;
    }

    .history-notes {
      margin-top: 10px;

      font-size: 0.9rem;
      line-height: 1.45;
    }

    .history-rating {
      white-space: nowrap;

      color: var(--accent);

      font-weight: 800;
    }

    .empty-state {
      padding: 35px 10px;

      text-align: center;

      color: var(--muted);
    }

    /* ---------------- MOBILE ---------------- */

    @media (max-width: 780px) {

      .app {
        width: min(94%, 600px);
      }

      header {
        align-items: flex-start;
        flex-direction: column;
      }

      nav {
        width: 100%;
      }

      .nav-button {
        flex: 1;
      }

      .practice-layout,
      .topics-layout {
        grid-template-columns: 1fr;
      }

      .selection-card {
        min-height: auto;
      }

      .selected-topic {
        min-height: 70px;
      }

      .topic-form {
        flex-direction: column;
      }
    }
  </style>
</head>

<body>

  <div class="app">

    <header>

      <div class="logo" id="homeLogo" style="cursor: pointer;">
         <h1>ROMODEX</h1>
          <p>go study.</p>
      </div>

      <nav>

        <button
          class="nav-button active"
          data-page="practicePage"
        >
          Practice
        </button>

        <button
          class="nav-button"
          data-page="topicsPage"
        >
          Topics
        </button>

        <button
          class="nav-button"
          data-page="historyPage"
        >
          History
        </button>

      </nav>

    </header>


    <!-- ==================================================
         PRACTICE
    ================================================== -->

    <main
      id="practicePage"
      class="page active"
    >

      <!-- PICK TOPIC -->

      <section id="pickerScreen">

        <div class="practice-layout">

          <div class="card picker-card">

            <div class="picker-title">
              <h2>Choose a topic</h2>
              <div class="small">
                Scroll manually or randomize.
              </div>
            </div>


            <div class="picker-container">

              <div class="picker-fade-top"></div>

              <div class="selection-box"></div>

              <div
                id="topicPicker"
                class="topic-picker"
              ></div>

              <div class="picker-fade-bottom"></div>

            </div>


            <button
              id="randomizeButton"
              class="primary"
            >
              Randomize
            </button>

          </div>


          <div class="card selection-card">

            <div class="selection-label">
              Current topic
            </div>

            <div
              id="selectedTopic"
              class="selected-topic"
            >
              Add a topic to begin
            </div>
        
            <div
              id="decisionButtons"
              class="decision-buttons hidden"
            >

              <button
                id="knowButton"
                class="decision-button"
              >
                <strong>I know it</strong>

                <span>
                  Research for 3 minutes, then explain it
                  for 1 minute.
                </span>
              </button>


              <button
                id="dontKnowButton"
                class="decision-button"
              >
                <strong>I don't know it</strong>

                <span>
                  Research for 10 minutes, then explain it
                  for 3 minutes.
                </span>
              </button>


              <button
                id="skipButton"
                class="secondary"
              >
                Skip
              </button>

            </div>

          </div>

        </div>

      </section>


      <!-- RESEARCH -->

      <section
        id="researchScreen"
        class="hidden"
      >

        <div class="card session-card">

          <div class="phase-label">
            Research
          </div>

          <h2
            id="researchTopic"
            class="session-topic"
          ></h2>


          <div
            id="researchTimer"
            class="timer"
          >
            03:00
          </div>


          <label>

            <span class="small">
              Research notes
            </span>

            <textarea
              id="researchNotes"
              placeholder="Capture the concepts you want to remember..."
            ></textarea>

          </label>


          <div class="controls">

            <button
              id="pauseResearchButton"
              class="secondary"
            >
              Pause
            </button>

            <button
              id="restartResearchButton"
              class="secondary"
            >
              Restart
            </button>

            <button
              id="startRecitationButton"
              class="primary"
            >
              Start recitation
            </button>
            <button
              id="backToTopicsButton"
              class="secondary"
            >
              Back to topics
            </button>
          </div>

        </div>

      </section>


      <!-- RECITATION -->

      <section
        id="recitationScreen"
        class="hidden"
      >

        <div class="card session-card">

          <div class="phase-label">
            Recite from memory
          </div>

          <h2
            id="recitationTopic"
            class="session-topic"
          ></h2>


          <div
            id="recitationTimer"
            class="timer"
          >
            01:00
          </div>


          <p class="recitation-instruction">
            Your research notes are hidden. Explain the topic
            from memory. Aim for a coherent explanation rather
            than simply listing facts.
          </p>


          <div class="controls">

            <button
              id="pauseRecitationButton"
              class="secondary"
            >
              Pause
            </button>

            <button
              id="restartRecitationButton"
              class="secondary"
            >
              Restart
            </button>

            <button
              id="finishRecitationButton"
              class="primary"
            >
              Finish
            </button>

          </div>

        </div>

      </section>


      <!-- REVIEW -->

      <section
        id="reviewScreen"
        class="hidden"
      >

        <div class="card session-card">

          <div class="phase-label">
            Review
          </div>

          <h2
            id="reviewTopic"
            class="session-topic"
          ></h2>


          <p>
            How well could you explain it without your notes?
          </p>


          <div class="rating-container">

            <button
              class="rating-button"
              data-rating="1"
            >
              1
            </button>

            <button
              class="rating-button"
              data-rating="2"
            >
              2
            </button>

            <button
              class="rating-button"
              data-rating="3"
            >
              3
            </button>

            <button
              class="rating-button"
              data-rating="4"
            >
              4
            </button>

            <button
              class="rating-button"
              data-rating="5"
            >
              5
            </button>

          </div>


          <label>

            <span class="small">
              What did you miss?
            </span>

            <textarea
              id="reviewNotes"
              placeholder="Concepts you forgot, got wrong, or need to revisit..."
            ></textarea>

          </label>


          <div class="controls">

            <button
              id="saveSessionButton"
              class="primary"
            >
              Save session
            </button>

            <button
              id="discardSessionButton"
              class="secondary"
            >
              Don't save
            </button>

          </div>

        </div>

      </section>

    </main>


    <!-- ==================================================
         TOPICS
    ================================================== -->

    <main
      id="topicsPage"
      class="page"
    >

      <div class="topics-layout">

        <section class="card">

          <h2>Add a topic</h2>

          <p class="muted">
            Topics are stored locally in your browser.
          </p>


          <form
            id="topicForm"
            class="topic-form"
          >

            <input
              id="topicInput"
              type="text"
              placeholder="e.g. Nephrotic syndrome"
              autocomplete="off"
            >

            <button
              type="submit"
              class="primary"
            >
              Add
            </button>

          </form>

        </section>


        <section class="card">

          <h2>Your topics</h2>

          <div
            id="topicCount"
            class="small"
          ></div>

          <div
            id="topicList"
            class="topic-list"
          ></div>

        </section>

      </div>

    </main>


    <!-- ==================================================
         HISTORY
    ================================================== -->

    <main
      id="historyPage"
      class="page"
    >

      <section class="card">

        <h2>Practice history</h2>

        <p class="muted">
          Completed sessions and self-ratings.
        </p>

        <div
          id="historyList"
          class="history-list"
        ></div>

      </section>

    </main>

  </div>


  <script src="app.js"></script>

</body>
</html>
